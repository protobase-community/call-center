# gpt-realtime-2.1, the model the agent talks through
OPENAI_API_KEY=

# The call center app's phone-line function, such as https://example.com/api/functions/phone-line,
# or http://localhost:5173/api/functions/phone-line for `bun run dev`, and the app's
# PHONE_LINE_SECRET, which signs each request (whsec_ and base64). Both are required; plain http is
# taken only on this machine. tests/sip_call/run.sh sets its own for the stand-in.
CALL_CENTER_URL=
CALL_CENTER_SECRET=

# The app's account of the phone_line role the bridge signs in with, to join each call's Protobase
# call as the caller; the bridge does not start without them
PHONE_LINE_EMAIL=
PHONE_LINE_PASSWORD=

# Minutes a caller who asked for a person waits on hold before the assistant comes back and offers a
# ticket instead (a positive whole number, 5 when empty), and an audio file to play as hold music
# instead of hold_music/hold-music.ogg
MAX_WAIT_MINUTES=
HOLD_MUSIC_FILE=

# The local livekit-server from compose.yaml, which runs on this key pair instead of its public dev one.
# Generate the secret with `openssl rand -hex 32`; compose refuses to start without it. The app's .env
# names the same pair, since the app's calls use this server too.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=local
LIVEKIT_API_SECRET=

# Your own SIP trunk file instead of sip/inbound-trunk.json, which is for local development only
SIP_TRUNK_FILE=
